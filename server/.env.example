# EXTROVELA Backend Environment Configuration

PORT=5000

# Set to "production" on a real deployment. This ALSO controls whether the
# Phase 11 intelligence routes will serve unverified requests — see section 4.
NODE_ENV=development

# ─── 1. MongoDB Database ───────────────────────────────────────
# Free M0 cluster at https://www.mongodb.com/cloud/atlas or local MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/extrovela
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/extrovela?retryWrites=true&w=majority

# ─── 2. Google Gemini Flash Live Quest AI Engine ───────────────
# Free API key from Google AI Studio: https://aistudio.google.com/
# Stored securely on backend only — never leaked to mobile or web clients
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ─── 3. Phase 11 Model Routing ─────────────────────────────────
# Two tiers. Cheap handles classification, tag extraction, and memory titles.
# Strong handles quest generation and recap narratives.
# If unset, the defaults below are used. Both are optional.
GEMINI_MODEL_CHEAP=gemini-1.5-flash-8b
GEMINI_MODEL_STRONG=gemini-1.5-flash

# ─── 4. Server-Side Identity Verification ──────────────────────
# ┌───────────────────────────────────────────────────────────────────────────┐
# │ STATUS: NOT IMPLEMENTED — REQUIRES EXTERNAL CONFIGURATION                 │
# │                                                                           │
# │ `firebase-admin` is NOT currently a dependency of this backend, so the    │
# │ server cannot cryptographically verify a Firebase ID token. Until it is   │
# │ installed and credentialed, /api/intelligence/* returns 501 in            │
# │ production (it fails closed rather than trusting a client-sent userId).   │
# │                                                                           │
# │ To enable real verification:                                              │
# │   1. cd server && npm install firebase-admin                              │
# │   2. set GOOGLE_APPLICATION_CREDENTIALS or FIREBASE_SERVICE_ACCOUNT_JSON  │
# │ No route code changes are required — requireIdentity.js picks it up.      │
# └───────────────────────────────────────────────────────────────────────────┘

# Path to a service-account JSON file (preferred for VM / container deploys).
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/extrovela-service-account.json

# Or the service-account JSON inlined as a single-line string (for hosts that
# only support env vars, e.g. Render / Railway / Fly).
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ESCAPE HATCH — DO NOT ENABLE IN PRODUCTION.
# Setting this to "true" makes the server trust the client-supplied x-user-id
# header with no verification. It exists only for local integration testing
# against NODE_ENV=production. Anyone could impersonate any user.
# TRUST_CLIENT_USER_ID=false

# ─── 5. Phase 13 Real-World Intelligence Providers ─────────────
# The backend proxies weather / places / routing so any SECRET provider key stays
# server-side and is NEVER shipped in the client bundle. The keyless OpenStreetMap
# / Open-Meteo / OSRM providers are the DEFAULT and work with no keys. Point a
# *_PROVIDER at a keyed provider only after supplying its key below. If a selected
# provider's key is missing the service fails CLEAN (503) — it never fabricates data.

# Weather: "open-meteo" (keyless, default) | "openweather" (requires key)
WEATHER_PROVIDER=open-meteo
# OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
OPENWEATHER_API_KEY=

# Places: "osm" (keyless Overpass + Nominatim, default) | "geoapify" (requires key)
PLACES_PROVIDER=osm
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OSM etiquette REQUIRES a descriptive User-Agent identifying your app + a contact.
# Set this before using the keyless OSM places provider in any real deployment.
NOMINATIM_USER_AGENT=Extrovela/1.0 (contact: you@example.com)
GEOAPIFY_API_KEY=

# Routing: "osrm" (keyless, default) | "ors" (OpenRouteService, requires key)
# NOTE: the public OSRM demo server only supports the driving/car profile; for
# real walking/cycling routing, self-host OSRM or use a keyed provider.
ROUTING_PROVIDER=osrm
# OSRM_URL=https://router.project-osrm.org
ORS_API_KEY=

# Events: NOT IMPLEMENTED — no keyless option exists, so leave EVENTS_PROVIDER=none.
# When an events provider is wired up it will be key-gated and fail clean when the
# key is absent (never fabricated). EVENTS_API_KEY is a placeholder only for now.
EVENTS_PROVIDER=none
EVENTS_API_KEY=

# ─── 6. CORS & Admin (previously undocumented) ─────────────────
# Comma-separated list of extra browser origins allowed to call the API in
# production (localhost dev origins are always allowed). Example:
# ALLOWED_ORIGINS=https://app.extrovela.com,https://extrovela.com
ALLOWED_ORIGINS=

# Shared secret gating /api/admin/* (constant-time compared). In production the
# admin routes are REFUSED until this is set; in development they are open with a
# loud warning. Generate a long, random value.
ADMIN_SECRET_KEY=
