# ============================================================
# EXTROVELA — Environment Configuration
# ============================================================

# ------------------------------------------------------------
# 1. Client-Safe Environment Variables (Vite / Mobile Bundle)
# ------------------------------------------------------------
# Current environment: development | staging | production
VITE_APP_ENV=development

# Backend API Base URL
VITE_API_URL=http://localhost:5000

# Firebase Client Configuration (From Firebase Console > Project Settings > General > Your Apps)
# Client SDK keys identify your project and are safe to bundle with Firebase App Check & Security Rules.
VITE_FIREBASE_API_KEY=AIzaSyYourClientApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=extrovela-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=extrovela-app
VITE_FIREBASE_STORAGE_BUCKET=extrovela-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_CRASHLYTICS=true
VITE_ENABLE_PERF=true
VITE_ENABLE_APP_CHECK=false
VITE_MOCK_OFFLINE=false

# Phase 13 real-world providers: DEV/TEST ONLY mock toggle. When "true" (and only
# outside production), weather/places services return canned mock data instead of
# calling the backend providers. This is HARD-BLOCKED in production builds — even
# if set to "true", a production bundle ignores it and never serves mock data.
VITE_USE_MOCK_PROVIDERS=false

# Phase 14 social experiences: DEV/TEST ONLY mock toggle. When "true" (and only
# outside production), social repository seeds fake companions and handle results.
# HARD-BLOCKED in production builds — resolves to false even if set here.
VITE_USE_MOCK_SOCIAL=false


# ------------------------------------------------------------
# 2. Server-Only Secrets (Backend / Cloud Functions / Cloud Run)
# ------------------------------------------------------------
# WARNING: NEVER prefix with VITE_ or expose to client builds.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/extrovela
GEMINI_API_KEY=AIzaSyYourSecretGeminiApiKeyHere

FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
ADMIN_SECRET_KEY=your_admin_secret_key_here
